<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Bridge.WindowsAgent</AssemblyName>
    <RootNamespace>Bridge.WindowsAgent</RootNamespace>
    <Version>0.0.1</Version>
    <Description>Contract-only Windows tray starter; desktop control is not implemented.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bridge.DeviceIdentity\Bridge.DeviceIdentity.csproj" />
    <ProjectReference Include="..\Bridge.DesktopCore\Bridge.DesktopCore.csproj" />
    <ProjectReference Include="..\Bridge.Win32\Bridge.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
</Project>
