# Copy to .env and fill in. Never commit a filled .env.
# The domain is a placeholder until the owner decides the real one.

# Public HTTPS origin of the relay (no scheme, no trailing slash).
# Example: bridge.example.com — NEVER use bridge.example.invalid
# in a real deployment; .invalid is reserved for documentation.
BRIDGE_DOMAIN=bridge.example.invalid

# Path (on the Docker host) to the OpenIddict signing PFX.
# Generate with deploy/scripts/generate-signing-cert.sh.
# Back the PFX up offline; losing it invalidates every token and
# every device pairing must be re-done.
SIGNING_CERT_PATH=./secrets/signing.pfx

# Password for that PFX. Keep it out of chat, logs, and the repo.
SIGNING_CERT_PASSWORD=change-me-to-a-long-random-password
